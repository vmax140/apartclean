# Primer promenljivih okruženja. Kopiraj u .env.local i popuni pravim vrednostima.
# .gitignore isključuje sve .env fajlove osim ovog primera.

# --- Javno (sme u klijenta: web i telefon) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Tajno: NIKAD u apps/web ni apps/mobile ---
# Ovo ide u Supabase secrets (supabase secrets set ...) i koriste ga samo
# Edge Functions i testovi. Ako se nađe u klijentskom kodu, to je greška.
SUPABASE_SERVICE_ROLE_KEY=
# Ključ za Claude API, koristi ga Edge Function ai-inspect (Faza 3A, SPEC sekcija 8).
ANTHROPIC_API_KEY=
# Ključ za šifrovanje šifri sefa i WiFi lozinki (Faza 1C, SPEC sekcija 4).
PROPERTY_SECRET_KEY=
